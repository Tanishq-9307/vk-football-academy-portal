# Copy this file to .env and fill in the values from your Supabase project:
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Never put the Supabase service_role key in this file or in frontend code.
# The anon key is safe to ship in the browser; row-level security (RLS)
# in supabase/schema.sql is what actually protects the data.
